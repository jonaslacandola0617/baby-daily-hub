generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model RoutineItem {
  id        String   @id @default(cuid())
  timeStart String
  timeEnd   String?
  activity  String
  note      String?
  category  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyTracker {
  id          String   @id @default(cuid())
  date        String   @unique
  sleepHours  Float    @default(11)
  napHours    Float    @default(1.5)
  waterCups   Int      @default(0)
  diaperCount Int      @default(0)
  temperature String?
  weight      String?
  medicine    String?
  mood        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MealLog {
  id        String   @id @default(cuid())
  date      String   @unique
  breakfast String?
  lunch     String?
  dinner    String?
  snacks    String?
  vitamins  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Recipe {
  id          String   @id @default(cuid())
  name        String
  category    String   // breakfast | lunch | dinner | snack | any
  description String?
  ingredients String   // stored as newline-separated list
  steps       String   // stored as newline-separated steps
  prepTime    String?  // e.g. "10 mins"
  tags        String?  // comma-separated e.g. "quick,finger-food,no-cook"
  isFavourite Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Toy {
  id           String    @id @default(cuid())
  name         String
  category     String
  description  String?
  emoji        String    @default("🧸")
  isActive     Boolean   @default(false)
  isFavourite  Boolean   @default(false)
  loveCount    Int       @default(0)
  lastActiveAt DateTime?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model RotationLog {
  id           String   @id @default(cuid())
  rotatedAt    DateTime @default(now())
  theme        String?
  activeSetIds String
  inIds        String
  outIds       String
  notes        String?
}

model RotationSettings {
  id             String    @id @default(cuid())
  activeSetSize  Int       @default(4)
  scheduleDays   Int       @default(7)
  lastRotatedAt  DateTime?
  nextRotationAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Milestone {
  id        String   @id @default(cuid())
  text      String
  category  String
  status    String   @default("pending")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id          String   @id @default(cuid())
  date        String   @unique
  dailyNotes  String?
  parentNotes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Appointment {
  id        String   @id @default(cuid())
  date      String
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BabyProfile {
  id        String   @id @default(cuid())
  name      String   @default("Your Little One")
  birthdate String?
  vitaminList String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
